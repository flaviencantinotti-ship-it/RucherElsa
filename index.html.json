{"content":[{"id":"2c8e4717","settings":{"content_width":"full","background_background":"classic","background_color":"#0a0908","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"min_height":{"unit":"px","size":0,"sizes":[]},"_element_id":"section-nav"},"elements":[{"id":"289ce2e9","settings":{"html":"<style>\n:root{\n  --black:#0a0908; --black-2:#121110; --honey:#dc9f2e; --honey-light:#f0c878;\n  --cream:#f5efe1; --cream-dim:#a89f8c; --rust:#7a4b23;\n}\n*{box-sizing:border-box;}\nhtml{width:100%;overflow-x:hidden;scroll-behavior:smooth;}\n#hero,#histoire,#miel,#pollinisation,#contact{scroll-margin-top:100px;}\nbody,.elementor,.elementor-widget-container{width:100% !important;max-width:100% !important;overflow-x:hidden;}\n.rdl-scope{background:var(--black);color:var(--cream);font-family:'Manrope',sans-serif;font-weight:400;line-height:1.6;width:100%;}\n.rdl-scope h1,.rdl-scope h2,.rdl-scope h3{font-family:'Fraunces',serif;font-weight:500;letter-spacing:-0.01em;color:var(--cream);}\n.rdl-scope a{color:inherit;text-decoration:none;}\n.rdl-scope .wrap{max-width:1180px;margin:0 auto;padding:0 32px;position:relative;z-index:2;width:100%;}\n.rdl-scope .eyebrow{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--honey);}\n.rdl-scope .reveal{opacity:0;transform:translateY(24px);transition:opacity .8s ease, transform .8s ease;}\n.rdl-scope .reveal.in{opacity:1;transform:translateY(0);}\n\n\/* ---- torch + hex field system, fixed across the whole page ---- *\/\n#torch-hexfield{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:0.5;}\n#torch-hexfield svg{width:100%;height:100%;}\n#torch-glow{position:fixed;inset:0;z-index:3;pointer-events:none;mix-blend-mode:screen;\n  background:radial-gradient(circle 380px at var(--mx,50%) var(--my,50%), rgba(220,159,46,0.45), rgba(220,159,46,0.10) 40%, transparent 70%);\n  transition:opacity .4s ease;}\n#torch-vignette{position:fixed;inset:0;z-index:1;pointer-events:none;\n  background:radial-gradient(circle 460px at var(--mx,50%) var(--my,50%), transparent 0%, rgba(0,0,0,0.35) 75%);}\n\n.rdl-scope nav{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;\n  padding:30px 44px;background:rgba(10,9,8,0.55);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);\n  border-bottom:1px solid rgba(245,239,225,0.06);}\n.rdl-scope .logo{font-family:'Fraunces',serif;font-size:24px;display:flex;align-items:center;gap:12px;}\n.rdl-scope .logo svg{width:30px;height:30px;}\n.rdl-scope .nav-links{display:flex;gap:38px;font-size:16px;font-weight:500;}\n.rdl-scope .nav-links a{opacity:.85;position:relative;padding-bottom:4px;}\n.rdl-scope .nav-links a::after{content:'';position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--honey);transition:width .3s;}\n.rdl-scope .nav-links a:hover::after{width:100%;}\n.rdl-scope .btn{display:inline-flex;align-items:center;gap:8px;padding:13px 24px;border-radius:2px;font-size:14px;font-weight:600;\n  border:1px solid var(--honey);color:var(--black);background:var(--honey);transition:transform .25s, background .25s;white-space:nowrap;}\n.rdl-scope .btn:hover{background:var(--honey-light);}\n.rdl-scope .btn-ghost{background:transparent;color:var(--cream);border:1px solid rgba(245,239,225,0.25);}\n.rdl-scope .btn-ghost:hover{border-color:var(--honey);color:var(--honey);}\n\n\/* mobile burger *\/\n.rdl-scope .burger{display:none;background:none;border:1px solid rgba(245,239,225,0.3);border-radius:2px;\n  width:42px;height:42px;color:var(--cream);font-size:20px;cursor:pointer;align-items:center;justify-content:center;}\n.rdl-scope .nav-mobile{display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:60;background:rgba(10,9,8,0.98);\n  flex-direction:column;align-items:center;justify-content:center;gap:32px;}\n.rdl-scope .nav-mobile.open{display:flex;}\n.rdl-scope .nav-mobile a{font-family:'Fraunces',serif;font-size:28px;color:var(--cream);}\n.rdl-scope .nav-mobile .close{position:absolute;top:28px;right:28px;background:none;border:none;color:var(--cream);font-size:28px;cursor:pointer;}\n\n.rdl-scope .hero{position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;width:100%;}\n.rdl-scope .hero-content{position:relative;z-index:2;width:100%;padding-top:80px;}\n.rdl-scope .hero-tag{display:flex;align-items:center;gap:10px;margin-bottom:22px;}\n.rdl-scope .hero-tag .line{width:36px;height:1px;background:var(--honey);}\n.rdl-scope .hero h1{font-size:clamp(38px,6.2vw,86px);line-height:1.05;max-width:920px;margin-bottom:26px;}\n.rdl-scope .hero h1 em{font-style:italic;color:var(--honey);}\n.rdl-scope .hero-sub{font-size:clamp(15px,2vw,18px);color:var(--cream-dim);max-width:520px;margin-bottom:40px;}\n.rdl-scope .hero-actions{display:flex;gap:16px;flex-wrap:wrap;}\n.rdl-scope .scroll-cue{position:absolute;bottom:40px;left:32px;display:flex;align-items:center;gap:12px;font-size:12px;color:var(--cream-dim);z-index:2;}\n.rdl-scope .scroll-cue .stick{width:1px;height:36px;background:linear-gradient(to bottom, var(--honey), transparent);animation:sm 2.2s ease-in-out infinite;}\n@keyframes sm{0%,100%{opacity:.3}50%{opacity:1}}\n\n.rdl-scope .story{padding:150px 0 110px;width:100%;}\n.rdl-scope .story-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:80px;align-items:center;}\n.rdl-scope .story-visual{aspect-ratio:4\/5;border-radius:6px;background:var(--black-2);border:1px solid rgba(220,159,46,0.15);position:relative;overflow:hidden;}\n.rdl-scope .story-visual .frame-label{position:absolute;bottom:24px;left:24px;right:24px;font-size:12px;color:var(--cream-dim);border-top:1px solid rgba(245,239,225,0.12);padding-top:14px;}\n.rdl-scope .story h2{font-size:clamp(28px,3.4vw,44px);margin:14px 0 24px;line-height:1.15;}\n.rdl-scope .story p{color:var(--cream-dim);font-size:16px;margin-bottom:18px;max-width:480px;}\n.rdl-scope .story-facts{display:flex;gap:40px;margin-top:36px;flex-wrap:wrap;}\n.rdl-scope .fact b{display:block;font-family:'Fraunces',serif;font-size:30px;color:var(--honey);}\n.rdl-scope .fact span{font-size:13px;color:var(--cream-dim);}\n\n.rdl-scope .products{padding:100px 0;width:100%;}\n.rdl-scope .section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:56px;gap:24px;flex-wrap:wrap;}\n.rdl-scope .section-head h2{font-size:clamp(26px,3.2vw,42px);margin-top:12px;max-width:520px;}\n.rdl-scope .section-head p{color:var(--cream-dim);max-width:340px;font-size:15px;}\n.rdl-scope .hex-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}\n.rdl-scope .hex-card{padding:38px 26px 30px;background:var(--black-2);border:1px solid rgba(245,239,225,0.08);\n  clip-path:polygon(8% 0,92% 0,100% 50%,92% 100%,8% 100%,0 50%);transition:transform .4s, border-color .4s;}\n.rdl-scope .hex-card:hover{transform:translateY(-6px);border-color:var(--honey);}\n.rdl-scope .hex-card .num{font-size:12px;color:var(--rust);letter-spacing:.1em;margin-bottom:16px;display:block;}\n.rdl-scope .hex-card h3{font-size:22px;margin-bottom:10px;}\n.rdl-scope .hex-card p{font-size:14px;color:var(--cream-dim);margin-bottom:18px;}\n.rdl-scope .hex-card .price{font-family:'Fraunces',serif;color:var(--honey);font-size:18px;}\n\n.rdl-scope .service{padding:120px 0;border-top:1px solid rgba(245,239,225,0.06);width:100%;}\n.rdl-scope .service-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;}\n.rdl-scope .service h2{font-size:clamp(26px,3.2vw,42px);margin:14px 0 22px;}\n.rdl-scope .service p{color:var(--cream-dim);margin-bottom:28px;max-width:460px;}\n.rdl-scope .service-list li{list-style:none;display:flex;gap:16px;padding:20px 0;border-bottom:1px solid rgba(245,239,225,0.08);align-items:flex-start;}\n.rdl-scope .service-list li:first-child{border-top:1px solid rgba(245,239,225,0.08);}\n.rdl-scope .service-list .ico{color:var(--honey);font-family:'Fraunces',serif;font-size:15px;width:26px;flex-shrink:0;}\n.rdl-scope .service-list b{display:block;font-size:15px;margin-bottom:4px;}\n.rdl-scope .service-list span{font-size:14px;color:var(--cream-dim);}\n.rdl-scope .service-visual{aspect-ratio:1\/1;border:1px solid rgba(220,159,46,0.12);border-radius:6px;}\n\n.rdl-scope footer{padding:120px 0 50px;border-top:1px solid rgba(245,239,225,0.06);width:100%;}\n.rdl-scope .cta-block{text-align:center;max-width:640px;margin:0 auto 100px;}\n.rdl-scope .cta-block h2{font-size:clamp(28px,4.2vw,54px);margin-bottom:22px;}\n.rdl-scope .cta-block p{color:var(--cream-dim);margin-bottom:36px;}\n.rdl-scope .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:60px;border-top:1px solid rgba(245,239,225,0.08);padding-top:56px;}\n.rdl-scope .foot-grid h4{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--honey);margin-bottom:18px;}\n.rdl-scope .foot-grid p,.rdl-scope .foot-grid a{font-size:14px;color:var(--cream-dim);display:block;margin-bottom:10px;}\n.rdl-scope .foot-grid a:hover{color:var(--honey);}\n.rdl-scope .foot-bottom{margin-top:70px;font-size:12px;color:var(--cream-dim);opacity:.6;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;}\n\n\/* ---------- RESPONSIVE ---------- *\/\n@media(max-width:1024px){\n  .rdl-scope .story-grid,.rdl-scope .service-grid{grid-template-columns:1fr;gap:44px;}\n  .rdl-scope .hex-grid{grid-template-columns:1fr 1fr;}\n  .rdl-scope nav{padding:22px 28px;}\n}\n@media(max-width:900px){\n  .rdl-scope .nav-links{display:none;}\n  .rdl-scope .burger{display:flex;}\n  .rdl-scope .hex-grid{grid-template-columns:1fr;}\n  .rdl-scope .foot-grid{grid-template-columns:1fr;gap:36px;}\n  .rdl-scope .hero h1{font-size:clamp(34px,9vw,56px);}\n  .rdl-scope .hex-card{clip-path:none;border-radius:6px;}\n}\n@media(max-width:600px){\n  .rdl-scope .wrap{padding:0 20px;}\n  .rdl-scope nav{padding:18px 20px;}\n  .rdl-scope .logo{font-size:19px;}\n  .rdl-scope .logo svg{width:24px;height:24px;}\n  .rdl-scope .btn-ghost{display:none;}\n  .rdl-scope .hero-actions{flex-direction:column;align-items:stretch;}\n  .rdl-scope .hero-actions .btn{justify-content:center;}\n  .rdl-scope .story,.rdl-scope .products,.rdl-scope .service{padding:70px 0;}\n  .rdl-scope footer{padding:80px 0 34px;}\n  .rdl-scope .story-facts{gap:24px;}\n  .rdl-scope .scroll-cue{display:none;}\n  .rdl-scope .foot-bottom{flex-direction:column;gap:6px;}\n}\n<\/style>\n<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https:\/\/fonts.gstatic.com\" crossorigin>\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<div id=\"torch-hexfield\">\n  <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n    <defs>\n      <pattern id=\"hexpat\" width=\"52\" height=\"90\" patternUnits=\"userSpaceOnUse\" patternTransform=\"scale(1)\">\n        <g fill=\"none\" stroke=\"rgba(220,159,46,0.35)\" stroke-width=\"1\">\n          <polygon points=\"26,2 47,15 47,42 26,55 5,42 5,15\"\/>\n          <polygon points=\"0,47 21,60 21,87 0,100 -21,87 -21,60\"\/>\n          <polygon points=\"52,47 73,60 73,87 52,100 31,87 31,60\"\/>\n        <\/g>\n      <\/pattern>\n    <\/defs>\n    <rect width=\"100%\" height=\"100%\" fill=\"url(#hexpat)\"\/>\n  <\/svg>\n<\/div>\n<div id=\"torch-vignette\"><\/div>\n<div id=\"torch-glow\"><\/div>\n<script>\n(function(){\n  if(window.__torchInit) return;\n  window.__torchInit = true;\n  document.addEventListener('mousemove', function(e){\n    document.documentElement.style.setProperty('--mx', e.clientX + 'px');\n    document.documentElement.style.setProperty('--my', e.clientY + 'px');\n  });\n  var io = new IntersectionObserver(function(entries){\n    entries.forEach(function(en){ if(en.isIntersecting) en.target.classList.add('in'); });\n  }, {threshold:0.15});\n  function watchReveals(){\n    document.querySelectorAll('.reveal:not(.in)').forEach(function(el){ io.observe(el); });\n  }\n  watchReveals();\n  window.addEventListener('load', watchReveals);\n  setTimeout(watchReveals, 800);\n\n  function bindBurger(){\n    var burger = document.getElementById('burgerBtn');\n    var mobileNav = document.getElementById('mobileNav');\n    var closeBtn = document.getElementById('mobileNavClose');\n    if(burger && mobileNav && !burger.dataset.bound){\n      burger.dataset.bound = \"1\";\n      burger.addEventListener('click', function(){ mobileNav.classList.add('open'); });\n      closeBtn.addEventListener('click', function(){ mobileNav.classList.remove('open'); });\n      mobileNav.querySelectorAll('a').forEach(function(a){\n        a.addEventListener('click', function(){ mobileNav.classList.remove('open'); });\n      });\n    }\n  }\n  bindBurger();\n  window.addEventListener('load', bindBurger);\n})();\n<\/script>\n<div class=\"rdl-scope\">\n<nav>\n  <div class=\"logo\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 2L21 7V17L12 22L3 17V7L12 2Z\" stroke=\"#dc9f2e\" stroke-width=\"1.3\"\/><\/svg>\n    Le Rucher d'Elsa\n  <\/div>\n  <div class=\"nav-links\">\n    <a href=\"#miel\">Le miel<\/a>\n    <a href=\"#histoire\">Notre histoire<\/a>\n    <a href=\"#pollinisation\">Pollinisation<\/a>\n    <a href=\"#contact\">Contact<\/a>\n  <\/div>\n  <a href=\"#contact\" class=\"btn btn-ghost\">Nous \u00e9crire<\/a>\n  <button class=\"burger\" id=\"burgerBtn\" aria-label=\"Ouvrir le menu\">\u2630<\/button>\n<\/nav>\n<div class=\"nav-mobile\" id=\"mobileNav\">\n  <button class=\"close\" id=\"mobileNavClose\" aria-label=\"Fermer\">\u2715<\/button>\n  <a href=\"#miel\">Le miel<\/a>\n  <a href=\"#histoire\">Notre histoire<\/a>\n  <a href=\"#pollinisation\">Pollinisation<\/a>\n  <a href=\"#contact\">Contact<\/a>\n<\/div>\n<\/div>"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"},{"id":"7e4e62a7","settings":{"content_width":"full","background_background":"classic","background_color":"#0a0908","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"min_height":{"unit":"px","size":0,"sizes":[]},"_element_id":"section-hero"},"elements":[{"id":"4075665b","settings":{"html":"<div class=\"rdl-scope\">\n<section class=\"hero\" id=\"hero\">\n  <div class=\"wrap hero-content\">\n    <div class=\"hero-tag reveal in\">\n\n      <span class=\"eyebrow\">bienvenue<\/span>\n    <\/div>\n    <h1 class=\"reveal in\">Le Rucher d'Elsa<br><em>Apicultrice et passionn\u00e9e.<\/em><\/h1>\n    <p class=\"hero-sub reveal in\">Vingt colonies conduites en transhumance entre garrigue et lavande.\n      R\u00e9colte \u00e0 la main, extraction \u00e0 froid sous 40\u00b0C, sans m\u00e9lange de miell\u00e9es.<\/p>\n    <div class=\"hero-actions reveal in\">\n      <a href=\"#miel\" class=\"btn\">D\u00e9couvrir le miel<\/a>\n      <a href=\"#histoire\" class=\"btn btn-ghost\">Notre histoire \u2192<\/a>\n    <\/div>\n  <\/div>\n\n<\/section>\n<\/div>"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"},{"id":"7142821d","settings":{"content_width":"full","background_background":"classic","background_color":"#0a0908","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"min_height":{"unit":"px","size":0,"sizes":[]},"_element_id":"section-histoire"},"elements":[{"id":"2751c698","settings":{"html":"<div class=\"rdl-scope\">\n<section class=\"story\" id=\"histoire\">\n  <div class=\"wrap story-grid\">\n    <div class=\"story-visual reveal\">\n      <div class=\"frame-label\">Cadre de hausse \u2014 miell\u00e9e de printemps, avril 2026<\/div>\n    <\/div>\n    <div class=\"reveal\">\n      <span class=\"eyebrow\">Notre histoire<\/span>\n      <h2>Un rucher n'a pas de<br>recette. Il a une saison.<\/h2>\n      <p>Depuis 2014, nous transhumons nos colonies au fil des floraisons : toutes fleurs de printemps\n        en avril, garrigue en juin, lavande de fin juin \u00e0 d\u00e9but ao\u00fbt. Chaque hausse est lev\u00e9e \u00e0 la fin\n        de la miell\u00e9e, jamais avant que le nectar ne soit opercul\u00e9.<\/p>\n      <p>Les cadres sont d\u00e9sopercul\u00e9s \u00e0 froid, centrifug\u00e9s sous 40\u00b0C puis d\u00e9cant\u00e9s plusieurs jours avant\n        la mise en pot \u2014 aucune chauffe, aucun ensemencement, pour garder intacts les enzymes et les\n        ar\u00f4mes de chaque terroir.<\/p>\n      <div class=\"story-facts\">\n        <div class=\"fact\"><b>20<\/b><span>ruches en activit\u00e9<\/span><\/div>\n        <div class=\"fact\"><b>4<\/b><span>terroirs butin\u00e9s<\/span><\/div>\n        <div class=\"fact\"><b>12<\/b><span>ans de pratique<\/span><\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n<\/div>"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"},{"id":"796cfd25","settings":{"content_width":"full","background_background":"classic","background_color":"#0a0908","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"min_height":{"unit":"px","size":0,"sizes":[]},"_element_id":"section-miel"},"elements":[{"id":"41d0cbcc","settings":{"html":"<div class=\"rdl-scope\">\n<section class=\"products\" id=\"miel\">\n  <div class=\"wrap\">\n    <div class=\"section-head reveal\">\n      <div><span class=\"eyebrow\">Nos r\u00e9coltes<\/span><h2>Trois terroirs, trois miels.<\/h2><\/div>\n      <p>R\u00e9colt\u00e9s s\u00e9par\u00e9ment selon la floraison butin\u00e9e, sans m\u00e9lange ni pasteurisation.<\/p>\n    <\/div>\n    <div class=\"hex-grid\">\n      <div class=\"hex-card reveal\"><span class=\"num\">01 \u2014 Avril<\/span><h3>Toutes fleurs de printemps<\/h3>\n        <p>La premi\u00e8re miell\u00e9e de l'ann\u00e9e, butin\u00e9e avant la mont\u00e9e des chaleurs. Miel doux et clair, qui cristallise vite en pot.<\/p>\n        <span class=\"price\">8,90 \u20ac \u00b7 pot de 250g<\/span><\/div>\n      <div class=\"hex-card reveal\"><span class=\"num\">02 \u2014 Juin<\/span><h3>Miel de garrigue<\/h3>\n        <p>Thym, romarin et ciste des collines s\u00e8ches. Ambr\u00e9, cors\u00e9, \u00e0 la pointe r\u00e9sineuse typique de la garrigue.<\/p>\n        <span class=\"price\">9,90 \u20ac \u00b7 pot de 250g<\/span><\/div>\n      <div class=\"hex-card reveal\"><span class=\"num\">03 \u2014 Juillet<\/span><h3>Miel de lavande<\/h3>\n        <p>Butin\u00e9 sur les plateaux de Haute-Provence entre fin juin et d\u00e9but ao\u00fbt. Texture fine, parfum floral persistant.<\/p>\n        <span class=\"price\">9,50 \u20ac \u00b7 pot de 250g<\/span><\/div>\n    <\/div>\n  <\/div>\n<\/section>\n<\/div>"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"},{"id":"15ea4d72","settings":{"content_width":"full","background_background":"classic","background_color":"#0a0908","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"min_height":{"unit":"px","size":0,"sizes":[]},"_element_id":"section-pollinisation"},"elements":[{"id":"4e87d609","settings":{"html":"<div class=\"rdl-scope\">\n<section class=\"service\" id=\"pollinisation\">\n  <div class=\"wrap service-grid\">\n    <div class=\"reveal\">\n      <span class=\"eyebrow\">Pour les agriculteurs<\/span>\n      <h2>Nos ruches travaillent aussi dans vos vergers.<\/h2>\n      <p>Mise \u00e0 disposition de colonies pour la pollinisation d'esp\u00e8ces \u00e0 forte d\u00e9pendance entomophile \u2014\n        amandiers, cerisiers, pruniers \u2014 sur la base d'un contrat simple qui fixe le calendrier de pose,\n        le nombre de colonies par hectare et la conduite du verger pendant la floraison.<\/p>\n      <ul class=\"service-list\">\n        <li><span class=\"ico\">01<\/span><div><b>Diagnostic de la parcelle<\/b><span>Visite avant floraison pour \u00e9valuer la surface et d\u00e9finir le nombre de colonies n\u00e9cessaires \u00e0 l'hectare.<\/span><\/div><\/li>\n        <li><span class=\"ico\">02<\/span><div><b>Installation et suivi<\/b><span>Colonies pos\u00e9es \u00e0 l'entr\u00e9e en floraison ; aucun traitement insecticide ou acaricide n'est appliqu\u00e9 en pr\u00e9sence des abeilles.<\/span><\/div><\/li>\n        <li><span class=\"ico\">03<\/span><div><b>Retrait en fin de floraison<\/b><span>Retrait d\u00e8s la chute des p\u00e9tales, avant la reprise des traitements phytosanitaires du verger.<\/span><\/div><\/li>\n      <\/ul>\n      <a href=\"#contact\" class=\"btn\" style=\"margin-top:32px;\">Demander un devis<\/a>\n    <\/div>\n    <div class=\"service-visual reveal\"><\/div>\n  <\/div>\n<\/section>\n<\/div>"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"},{"id":"3a4f6285","settings":{"content_width":"full","background_background":"classic","background_color":"#0a0908","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"min_height":{"unit":"px","size":0,"sizes":[]},"_element_id":"section-contact"},"elements":[{"id":"3a4a4398","settings":{"html":"<div class=\"rdl-scope\">\n<footer id=\"contact\">\n  <div class=\"wrap\">\n    <div class=\"cta-block reveal\">\n      <span class=\"eyebrow\">O\u00f9 nous trouver<\/span>\n      <h2>Le miel se d\u00e9guste sur place,<br>le mardi et le samedi.<\/h2>\n      <p>Vente directe au rucher, march\u00e9 de producteurs, ou exp\u00e9dition dans toute la France.<\/p>\n      <a href=\"#\" class=\"btn\">\u00c9crire au rucher<\/a>\n    <\/div>\n    <div class=\"foot-grid\">\n      <div><h4>Le Rucher d'Elsa<\/h4><p>Apiculture artisanale en Provence-Alpes-C\u00f4te d'Azur.<\/p><\/div>\n      <div><h4>Navigation<\/h4><a href=\"#miel\">Le miel<\/a><a href=\"#histoire\">Notre histoire<\/a><a href=\"#pollinisation\">Pollinisation<\/a><\/div>\n      <div><h4>Contact<\/h4><a href=\"#\">contact@rucherdelsa.fr<\/a><a href=\"#\">06 00 00 00 00<\/a><a href=\"#\">Provence-Alpes-C\u00f4te d'Azur<\/a><\/div>\n    <\/div>\n    <div class=\"foot-bottom\"><span>\u00a9 2026 Le Rucher d'Elsa<\/span><span>Mentions l\u00e9gales \u00b7 Politique de confidentialit\u00e9<\/span><\/div>\n  <\/div>\n<\/footer>\n<\/div>"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"}],"page_settings":[],"version":"0.4","title":"Ruche Elsa Onepage","type":"page"}